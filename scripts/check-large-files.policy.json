{
  "version": "2026-08-30.policy-v5",
  "newFileFailThreshold": 800,
  "growthAllowanceLines": 50,
  "policies": [
    {
      "id": "test-files",
      "description": "Tests stay visible in the watchlist but keep the legacy hard gate.",
      "priority": "P2",
      "warnThreshold": 2600,
      "failThreshold": 3000,
      "match": {
        "prefixes": [
          "src/test/"
        ],
        "suffixes": [
          ".test.ts",
          ".test.tsx",
          ".test.js",
          ".test.jsx"
        ]
      }
    },
    {
      "id": "bridge-runtime-critical",
      "description": "Bridge, runtime, and app-shell orchestration files get the strictest growth control.",
      "priority": "P0",
      "warnThreshold": 2200,
      "failThreshold": 2600,
      "match": {
        "exactPaths": [
          "src/services/tauri.ts",
          "src/app-shell.tsx",
          "src/app-shell/assembly/useAppShellRootComposition.ts",
          "src/app-shell/sections/layoutNodes/useAppShellLayoutNodesSection.tsx",
          "src-tauri/src/shared_session_v2.rs",
          "src-tauri/src/shared_runtime_coordinator.rs",
          "src-tauri/src/session_management.rs",
          "src-tauri/src/skills_hub.rs",
          "src-tauri/src/local_usage.rs",
          "src-tauri/src/types.rs",
          "src-tauri/src/shared_sessions.rs"
        ],
        "prefixes": [
          "src-tauri/src/backend/",
          "src-tauri/src/engine/",
          "src-tauri/src/git/",
          "src-tauri/src/runtime/",
          "src-tauri/src/codex/",
          "src-tauri/src/computer_use/",
          "src/app-shell/"
        ]
      }
    },
    {
      "id": "settings-view-sections",
      "description": "Settings view sections regrew after the 2026-07 split (SessionManagementSection 2547->2648); hold them below the feature-hotpath gate.",
      "priority": "P1",
      "warnThreshold": 1500,
      "failThreshold": 2000,
      "match": {
        "prefixes": [
          "src/features/settings/components/settings-view/sections/"
        ]
      }
    },
    {
      "id": "feature-hotpath",
      "description": "High-churn feature slices get earlier warning and a lower hard gate than the default pool.",
      "priority": "P1",
      "warnThreshold": 2400,
      "failThreshold": 2800,
      "match": {
        "exactPaths": [
          "src/utils/threadItems.ts"
        ],
        "prefixes": [
          "src/features/threads/",
          "src/features/messages/",
          "src/features/composer/",
          "src/features/git-history/",
          "src/features/settings/",
          "src/features/spec/",
          "src/features/workspaces/",
          "src/features/shared-session/"
        ]
      }
    },
    {
      "id": "styles",
      "description": "Large style surfaces should warn early but keep a slightly wider split window than runtime bridge files.",
      "priority": "P1",
      "warnThreshold": 2200,
      "failThreshold": 2800,
      "match": {
        "prefixes": [
          "src/styles/"
        ]
      }
    },
    {
      "id": "i18n",
      "description": "Locale bundles stay on the legacy hard gate while remaining visible in the watchlist.",
      "priority": "P2",
      "warnThreshold": 2600,
      "failThreshold": 3000,
      "match": {
        "prefixes": [
          "src/i18n/locales/"
        ]
      }
    }
  ],
  "defaultPolicy": {
    "id": "default-source",
    "description": "Fallback policy for source files outside specialized governance groups.",
    "priority": "P1",
    "warnThreshold": 2600,
    "failThreshold": 3000
  }
}
